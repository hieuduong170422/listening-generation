# ── API Key ────────────────────────────────────────────────────
# Google Gemini API key — used by both TTS Script Gen and Prompt Templates.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# ── Vertex AI cho Affiliate (sinh ảnh Nano Banana + video Veo, dùng credit GCP) ──
# Bật để feature "Generate Video Affiliate" dùng Vertex AI thay vì key Gemini trả phí.
# Cần: enable Vertex AI API + chạy `gcloud auth application-default login`.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=
# VEO_OUTPUT_GCS_URI=gs://your-bucket/veo-out   # chỉ cần cho bước tạo video Veo

# ── App Auth ───────────────────────────────────────────────────
# Password-gate the whole app. Leave blank = no login.
APP_PASSWORD=your_password_here
# Comma-separated usernames that can see the TTS Stats tab.
ADMIN_USERS=admin

# ── Prompt Template Engine: API key theo từng SDK (chỉ cần khi dùng) ──
# Model Gemini/Veo dùng GEMINI_API_KEY ở trên. Các SDK khác cần key riêng:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                  # endpoint tương thích OpenAI (tuỳ chọn)
# DASHSCOPE_API_KEY=                # DashScope/Qwen/Wan — dùng chung cả Podcast & Engine
# DASHSCOPE_BASE_URL=               # vd intl: https://dashscope-intl.aliyuncs.com/api/v1
# ELEVENLABS_API_KEY=               # dùng chung cho cả Podcast & Engine

# ── Turso (chỉ khi deploy stateless, vd Streamlit Cloud) ───────
# Local không cần — mặc định dùng file SQLite templates.db.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# DATABASE_PATH=templates.db        # đổi vị trí file DB (tuỳ chọn)

# Google Drive auto-upload cho Video Affiliate (bỏ trống = tắt).
# Cách bật: share thư mục Drive cho email service account (quyền Editor),
# dán ID thư mục (đoạn cuối URL) vào đây. Video sẽ vào <thư mục>/<mô tả sản phẩm>/.
AFFILIATE_DRIVE_FOLDER_ID=
