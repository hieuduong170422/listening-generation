# ── API Key ────────────────────────────────────────────────────
# Google Gemini API key — used by both TTS Script Gen and Prompt Templates.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# ── App Auth ───────────────────────────────────────────────────
# Password-gate the whole app. Leave blank = no login.
APP_PASSWORD=your_password_here
# Comma-separated usernames that can see the TTS Stats tab.
ADMIN_USERS=admin

# ── Prompt Template Engine (optional) ──────────────────────────
# SDK for the Prompt Templates feature: google-genai | openai | dashscope
# SDK=google-genai
# BASE_URL=                         # custom OpenAI-compatible endpoint
# API_KEY=                          # falls back to GEMINI_API_KEY if unset
